{
  "name": "telegram-alerts",
  "productName": "Telegram Alerts",
  "version": "1.0.0",
  "description": "Desktop notification app for Telegram channel @utraci",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg"
  },
  "keywords": ["telegram", "notifications", "alerts"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.telegramalerts.app",
    "productName": "Telegram Alerts",
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg"],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Telegram Alerts",
      "sign": false
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ]
  }
}
